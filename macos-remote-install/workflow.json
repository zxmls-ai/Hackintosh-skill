{
  "schema": "install-workflow-v1",
  "version": "0.2.10",
  "phases": [
    {
      "id": "00-remote",
      "title": "准备工作和远程接入",
      "mode": "executable",
      "inputs": [
        "A 的连接结果或已核验的连接资料",
        "账户凭据取得方式"
      ],
      "preconditions": [
        "B 能运行 Python 与 SSH 库",
        "用户授权连接 A"
      ],
      "actions": [
        "首次给用户操作时，先说明两台电脑的分工、现在和稍后的准备、安装路线，再给完整操作",
        "按需生成固定配置脚本",
        "解析回传",
        "指纹核对后认证",
        "核对 Windows 身份和管理员权限",
        "临时文件 SFTP 往返校验"
      ],
      "verification": [
        "ssh",
        "host_key",
        "identity",
        "admin",
        "sftp"
      ],
      "failure_route": "diagnose-00",
      "resume": "00-remote.verify",
      "next": "01-hardware"
    },
    {
      "id": "01-hardware",
      "title": "检查硬件和可装版本",
      "mode": "guided-contract",
      "inputs": [
        "已接通的 A",
        "用户的目标系统与用途"
      ],
      "preconditions": [
        "00 已通过并重新确认连接"
      ],
      "actions": [
        "运行固定硬件采集脚本",
        "补齐 ACPI、USB、显示布线",
        "查原作者兼容资料",
        "确定硬件路线、系统版本与安装网络"
      ],
      "verification": [
        "target_identity",
        "hardware_inventory",
        "compatibility_sources",
        "os_route",
        "installer_network"
      ],
      "failure_route": "diagnose-current",
      "resume": "01-hardware.review",
      "next": "02-storage"
    },
    {
      "id": "02-storage",
      "title": "备份文件和预留空间",
      "mode": "guided-contract",
      "inputs": [
        "现场磁盘布局",
        "安装位置与容量",
        "备份范围与目的地"
      ],
      "preconditions": [
        "硬件路线成立",
        "具体修改范围已授权"
      ],
      "actions": [
        "核对磁盘稳定身份",
        "备份与内容校验",
        "恢复抽查",
        "准备已批准的安装空间",
        "回读新布局"
      ],
      "verification": [
        "disk_identity",
        "authorization",
        "backup_content",
        "restore_sample",
        "partition_layout"
      ],
      "failure_route": "diagnose-current",
      "resume": "02-storage.revalidate",
      "next": "03-media"
    },
    {
      "id": "03-media",
      "title": "制作启动 U 盘",
      "mode": "guided-contract",
      "inputs": [
        "硬件路线",
        "已确认 U 盘",
        "已锁定组件版本"
      ],
      "preconditions": [
        "备份已核验",
        "清空具体 U 盘已授权"
      ],
      "actions": [
        "先展示 a RapidEFI（推荐）／b 相似配置／c 官方模板路线，由用户选择并用 choose-efi 登记，再 select-source",
        "复用有效本机 ACPI；缺少时自动准备 Python 并在 A 的 Windows 中导出",
        "下载校验",
        "组装本机 EFI",
        "运行 efi_audit.py 审计开关、条件、文件差异与版本依据，并纳入 firmware_config_review",
        "运行同版本 ocvalidate",
        "准备 U 盘",
        "写入并从 A 回读校验",
        "具体 GitHub 资产下载失败时换 A／B 取件，核验完整文件并经 SFTP 中转"
      ],
      "verification": [
        "usb_identity",
        "authorization",
        "component_sources",
        "ocvalidate",
        "recovery_integrity",
        "media_readback",
        "acpi_tables",
        "firmware_config_review"
      ],
      "failure_route": "diagnose-current",
      "resume": "03-media.validate",
      "next": "04-install",
      "acpi_collection": {
        "default": "windows-python",
        "extra_reboot_default": false,
        "reuse_valid_target_tables": true,
        "python": "reuse-working-interpreter-else-official-per-user-install",
        "native_exception": "verified-native-exporter-may-run-without-python-or-reboot",
        "alternative": {
          "method": "opencore-sysreport",
          "requires_user_choice": true,
          "purpose": "collect-only-return-to-windows",
          "debug_build_required": true
        },
        "gate": "real-table-files-plus-matching-config-and-assessment-required-before-install-handoff",
        "reference": "references/04-installer.md"
      },
      "efi_protocol": {
        "reference": "references/09-efi-diagnostics.md",
        "source_order": [
          "user-selected-rapidefi-or-similar-or-official-sample",
          "preserve-applicable-same-machine-baseline-for-comparison"
        ],
        "audit": "scripts/efi_audit.py",
        "runtime_verified_by_audit": false,
        "review_evidence": [
          "firmware_config_review",
          "media_readback"
        ],
        "source_gate": "select-source",
        "lookup": "scripts/solutions.py lookup efi",
        "reference_source_choice": "references/10-existing-solutions.md",
        "choice_action": "choose-efi",
        "choices": {
          "a": "RapidEFI-Tool generation then adaptation (recommended)",
          "b": "documented similar-machine EFI adaptation",
          "c": "AI adaptation from pinned official OpenCore Sample"
        },
        "picker_handoff": "Explain actual text or graphical picker and Spacebar auxiliary entries",
        "install_picker": {
          "HideAuxiliary": false,
          "gate": "EFI_PICKER_INVALID",
          "fallback_hint": "If only Windows is visible, press Spacebar."
        }
      }
    },
    {
      "id": "04-install",
      "title": "从 U 盘安装 macOS",
      "mode": "guided-contract",
      "inputs": [
        "可回退的安装介质",
        "用户现场反馈"
      ],
      "preconditions": [
        "介质校验通过",
        "已保存工作与 BIOS 原设置"
      ],
      "actions": [
        "交付必要 BIOS 设置与启动菜单步骤",
        "确认恢复界面与网络",
        "按 05 填好实际分区识别信息，交付八步 GUI 清单与重启选项表；默认英文卷名 macOS",
        "重新核对安装目标",
        "安装并按现场选择下一启动项",
        "首次引导失败先执行 09 固定排错流程；两轮无新证据返回基线、部署与日志核对"
      ],
      "verification": [
        "recovery_boot",
        "recovery_network",
        "target_reidentified",
        "desktop_observed"
      ],
      "failure_route": "diagnose-current",
      "resume": "04-install.current-boot",
      "next": "05-macos-remote",
      "human_handoff": {
        "reference": "references/05-boot-handoff.md",
        "default_volume_name": "macOS",
        "name_policy": "unique-ascii-english",
        "mode": "one-continuous-numbered-checklist-plus-boot-choice-table",
        "fill_before_handoff": [
          "approved-target-label",
          "display-capacity",
          "parent-disk",
          "boot-menu-key",
          "uefi-usb-entry"
        ],
        "stop_before_erase_if_uncertain": true,
        "per_click_reply_required": false
      }
    },
    {
      "id": "05-macos-remote",
      "title": "连接装好的 macOS",
      "mode": "guided-contract",
      "inputs": [
        "macOS 桌面与新地址",
        "用户启用远程登录"
      ],
      "preconditions": [
        "用户已进入 macOS"
      ],
      "actions": [
        "核验新系统主机密钥",
        "SSH 登录",
        "重新核对硬件、磁盘和实际启动 EFI",
        "采集 macOS 状态",
        "接通后立即进入 06 全机检查；不写硬盘 ESP，也不因桌面可用宣称安装已全部完成"
      ],
      "verification": [
        "ssh",
        "host_key",
        "identity",
        "macos_inventory",
        "active_efi"
      ],
      "failure_route": "diagnose-current",
      "resume": "05-macos-remote.verify",
      "next": "06-devices"
    },
    {
      "id": "06-devices",
      "title": "检查和修复硬件",
      "mode": "guided-contract",
      "inputs": [
        "设备与功能缺口",
        "可用配置基线",
        "用户功能需求"
      ],
      "preconditions": [
        "macOS 可远程访问",
        "有回退与现场恢复方式"
      ],
      "actions": [
        "运行 collect-macos.sh；与 Windows 清单逐件对照，先向用户展示异常／待测清单",
        "用 record-devices 登记完整清单；顺序为每张网卡→显卡→无线／蓝牙→USB→音频／存储／电源及系统功能",
        "某项无解或等现场配合时标 deferred/waiting-user，继续下一项；全部待办处理完且限制明确接受后才 review",
        "对照 Windows 清单逐件盘点本轮设备，分别记录每张网卡、无线与蓝牙",
        "对待修设备按稳定 ID 查询并登记同机成功驱动或上游项目，再在副本上试验",
        "核对设备 ID、系统 build、同机历史和原作者支持范围，依可回退基线逐件修复",
        "在最终将加载的网卡包上回读匹配字段的类型和值，核对目标接口和备用远程链路",
        "显卡重启后核实设备并运行真实工作负载，要求 Metal 计算时逐项回读校验",
        "单项完成或仍待查时先做下一项已授权的检查，记录实际动作后再交接",
        "需要插拔、重启、配对或唤醒的步骤合并交给用户"
      ],
      "verification": [
        "device_audit",
        "rollback_baseline",
        "gpu_test",
        "network_test",
        "usb_test",
        "wireless_test",
        "sleep_test",
        "limits_accepted"
      ],
      "failure_route": "diagnose-current",
      "resume": "06-devices.failed-function",
      "next": "07-boot",
      "device_gate": {
        "register": "record-devices",
        "schema": "device-audit-v1",
        "reference": "references/11-postinstall-contract.md",
        "deferred_is_complete": false,
        "source_search_before_repair": true,
        "esp_write_before_closed": false
      }
    },
    {
      "id": "07-boot",
      "title": "从硬盘启动",
      "mode": "guided-contract",
      "inputs": [
        "实测可用 EFI",
        "目标 ESP 与现有引导"
      ],
      "preconditions": [
        "阶段 06 清单已封口，实测结果或具体已接受限制均有证据",
        "配置基线可用",
        "具体 ESP 修改已授权"
      ],
      "actions": [
        "核验 06 封口证据、最终 EFI 与目标 ESP，备份 ESP 和固件启动项",
        "保留 Microsoft/OEM，引导副本仅调整迁移所需的菜单／启动项字段；复制后回读",
        "首次拔盘重启之前注册指向硬盘 ESP 的固件 Boot####，设置持久 BootOrder 优先并核对 BootNext",
        "ShowPicker=true，Timeout>=5；boot-ready 校验通过才交付拔盘冷启动指引",
        "确认无 U 盘时默认进入硬盘 OpenCore，分别冷启动两套系统；缺少实际测试不宣布完成"
      ],
      "verification": [
        "esp_identity",
        "authorization",
        "esp_backup",
        "efi_readback",
        "macos_cold_boot",
        "windows_cold_boot",
        "firmware_entry",
        "boot_priority",
        "picker_visible"
      ],
      "failure_route": "diagnose-current",
      "resume": "07-boot.cold-test",
      "next": "08-delivery",
      "boot_gate": {
        "pre_reboot": "boot-ready",
        "schema": "boot-readiness-v1",
        "reference": "references/11-postinstall-contract.md",
        "copy_only_is_complete": false,
        "launcher_config_only_is_registered": false
      }
    },
    {
      "id": "08-delivery",
      "title": "保存配置和恢复方法",
      "mode": "guided-contract",
      "inputs": [
        "全部检查记录",
        "可用 EFI 与恢复方式"
      ],
      "preconditions": [
        "主流程完成或已明确接受限制"
      ],
      "actions": [
        "整理实测状态",
        "导出私有配置备份",
        "写恢复指引、限制和未测项",
        "告诉用户哪些功能已实测、哪些仍待处理、备份和恢复方法在哪里"
      ],
      "verification": [
        "verified_efi",
        "recovery_instructions",
        "function_results",
        "unresolved_disclosed"
      ],
      "failure_route": "diagnose-current",
      "resume": "08-delivery.review",
      "next": null
    }
  ]
}
