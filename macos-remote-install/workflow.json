    {"id":"03-media","title":"EFI 与安装 U 盘","mode":"guided-contract","inputs":["硬件路线","已确认 U 盘","已锁定组件版本"],"preconditions":["备份已核验","清空具体 U 盘已授权"],"actions":["下载校验","组装本机 EFI","运行同版本 ocvalidate","准备 U 盘","写入并从 A 回读校验"],"verification":["usb_identity","authorization","component_sources","ocvalidate","recovery_integrity","media_readback"],"failure_route":"diagnose-current","resume":"03-media.validate","next":"04-install"},
