    {"id":"05-macos-remote","title":"macOS 远程接管","mode":"guided-contract","inputs":["macOS 桌面与新地址","用户启用远程登录"],"preconditions":["用户已进入 macOS"],"actions":["核验新系统主机密钥","SSH 登录","重新核对硬件、磁盘和实际启动 EFI","采集 macOS 状态"],"verification":["ssh","host_key","identity","macos_inventory","active_efi"],"failure_route":"diagnose-current","resume":"05-macos-remote.verify","next":"06-devices"},
    {"id":"06-devices","title":"设备与功能","mode":"guided-contract","inputs":["设备与功能缺口","可用配置基线","用户功能需求"],"preconditions":["macOS 可远程访问","有回退与现场恢复方式"],"actions":["按设备选择有依据的修复","分别备份、安装、重启与实测","合并必要的插拔、配对和唤醒反馈"],"verification":["rollback_baseline","gpu_test","network_test","usb_test","wireless_test","sleep_test","limits_accepted"],"failure_route":"diagnose-current","resume":"06-devices.failed-function","next":"07-boot"},
